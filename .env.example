# MediaBot Environment Configuration
# Copy this to .env and fill in your values

# ─── Telegram ────────────────────────────────────────────────
# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your server's public HTTPS URL where webhook.php is accessible
WEBHOOK_URL=https://yourdomain.com/webhook.php

# Your Telegram numeric User ID(s) — comma-separated for multiple admins
ADMIN_IDS=123456789

# Admin panel password (CHANGE THIS!)
ADMIN_PASSWORD=ChangeMe@2025!

# ─── Binary Paths ────────────────────────────────────────────
# Run: which yt-dlp
YTDLP_PATH=/usr/local/bin/yt-dlp

# Run: which python3
PYTHON_PATH=/usr/bin/python3

# Run: which ffmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
